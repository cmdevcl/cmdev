{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(secrets/**)",
      "Edit(.env*)",
      "Edit(!.env.example)",
      "Edit(secrets/**)"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  }
}
