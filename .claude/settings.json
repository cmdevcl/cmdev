{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.[!e]*)",
      "Read(**/.env.e[!x]*)",
      "Read(**/.env.ex[!a]*)",
      "Read(**/.env.example.*)",
      "Read(secrets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.[!e]*)",
      "Edit(**/.env.e[!x]*)",
      "Edit(**/.env.ex[!a]*)",
      "Edit(**/.env.example.*)",
      "Edit(secrets/**)",
      "Write(**/.env)",
      "Write(**/.env.[!e]*)",
      "Write(**/.env.e[!x]*)",
      "Write(**/.env.ex[!a]*)",
      "Write(**/.env.example.*)",
      "Write(secrets/**)"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  }
}
